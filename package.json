{
  "name": "foodshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:wasm",
    "dev": "bun run dev:web",
    "test": "bun test --pass-with-no-tests",
    "lint": "bun run lint:oxlint",
    "type-check": "bun run tsrs --noEmit",
    "type-check:tsc": "bun run tsc --noEmit",
    "clean": "bun run clean:web",
    "sim:run": "bun sim-runner.ts",
    "sim:smoke": "bun sim-runner.ts --smoke",
    "sim:clean": "bun sim-runner.ts --clean",
    "maestro:smoke": "bun maestro-runner.ts smoke",
    "maestro:test": "bun maestro-runner.ts test",
    "maestro:matrix": "bun maestro-matrix.ts",
    "disk:heal": "bun clean-disk.ts",
    "test:rust": "cargo test --workspace",
    "build:wasm": "bun build-wasm.ts",
    "clean:web": "rm -rf crates/web/.next crates/web/node_modules/.cache",
    "dev:web": "bun --cwd crates/web --bun next dev",
    "lint:oxlint": "bunx --bun oxlint --ignore-pattern=crates/** --ignore-pattern=packages/** --ignore-pattern=node_modules/**",
    "bench": "cargo bench --workspace",
    "cli": "bun cli.ts",
    "tui": "cargo run --bin fs-tui",
    "tui:verify": "cargo run --bin fs-tui -- verify",
    "auto": "bun cli.ts auto",
    "auto:quick": "bun cli.ts auto --quick",
    "auto:keep": "bun cli.ts auto --keep",
    "check:no-node": "bun scripts/check-no-node.ts",
    "auto:headless": "cargo run --bin fs-auto -- --quick"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "bun": ">=1.4.3-canary.20261019.1"
  },
  "packageManager": "bun@1.4.3-canary.20261019.1"
}
