{
  "name": "foodshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "sim:run": "bun sim-runner.ts",
    "sim:smoke": "bun sim-runner.ts --smoke",
    "sim:clean": "bun sim-runner.ts --clean",
    "maestro:smoke": "bun maestro-runner.ts smoke",
    "maestro:test": "bun maestro-runner.ts test",
    "maestro:matrix": "bun maestro-matrix.ts",
    "disk:heal": "bun clean-disk.ts",
    "test:rust": "cargo test --workspace",
    "build:wasm": "bun tools/build-wasm.ts",
    "bench": "cargo bench --workspace",
    "cli": "bun cli.ts",
    "tui": "cargo run --bin fs-tui",
    "tui:verify": "cargo run --bin fs-tui -- verify",
    "auto": "bun cli.ts auto",
    "auto:quick": "bun cli.ts auto --quick",
    "auto:keep": "bun cli.ts auto --keep",
    "auto:headless": "cargo run --bin fs-auto -- --quick"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.4.0"
}
