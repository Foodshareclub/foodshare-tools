{
  "name": "foodshare-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:wasm && bun run build:cli",
    "dev": "bun run dev:web",
    "test": "bun test --pass-with-no-tests",
    "lint": "bun run lint:oxlint",
    "type-check": "bun run tsrs --noEmit",
    "clean": "bun run clean:web",
    "sim:run": "cargo run --bin fs-sim",
    "sim:smoke": "cargo run --bin fs-sim -- --smoke",
    "sim:clean": "cargo run --bin fs-sim -- --clean",
    "maestro:smoke": "cargo run --bin fs-maestro -- smoke",
    "maestro:test": "cargo run --bin fs-maestro -- test",
    "maestro:matrix": "cargo run --bin fs-maestro -- matrix",
    "disk:heal": "cargo run --bin fs-orchestrator -- disk",
    "test:rust": "cargo test --workspace",
    "build:wasm": "cargo run --bin fs-wasm",
    "clean:web": "rm -rf crates/web/.next crates/web/node_modules/.cache",
    "dev:web": "bun --cwd crates/web --bun next dev",
    "lint:oxlint": "bunx --bun oxlint --ignore-pattern=crates/** --ignore-pattern=packages/** --ignore-pattern=node_modules/**",
    "bench": "cargo bench --workspace",
    "cli": "bun cli.ts",
    "tui": "cargo run --bin fs-tui",
    "tui:verify": "cargo run --bin fs-tui -- verify",
    "auto": "bun cli.ts auto",
    "auto:quick": "bun cli.ts auto --quick",
    "auto:keep": "bun cli.ts auto --keep",
    "check:no-node": "bun scripts/check-no-node.ts",
    "check:bun-modules": "bun scripts/check-bun-modules.ts",
    "check:yaml": "bun scripts/check-yaml.ts .github/workflows/*.yml",
    "docs:cli-reference": "bun scripts/generate-cli-reference.ts",
    "check:cli-reference": "bun scripts/generate-cli-reference.ts --check",
    "verify": "bun run check:no-node && bun run check:bun-modules && bun run lint && bun run type-check && bun run test",
    "auto:headless": "cargo run --bin fs-auto -- --quick",
    "build:cli": "bun build --compile --outfile dist/foodshare-cli cli.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "oxlint": "1.80.0",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
  },
  "engines": {
    "bun": ">=1.4.3-canary.20261019.1"
  },
  "packageManager": "bun@1.4.3-canary.20261019.1"
}
