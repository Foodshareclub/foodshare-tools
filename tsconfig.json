{
  "compilerOptions": {
    // Bun is the only runtime this project's scripts run on. `bun:fs`,
    // `bun:path` and `bun:os` are Bun's own spellings of the standard library
    // modules; the ambient declarations in `types/bun-modules.d.ts` give them
    // their types.
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["bun"]
  },
  "include": ["scripts", "types", "*.ts"],
  "exclude": ["node_modules", "packages", "crates"]
}
