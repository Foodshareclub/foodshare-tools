{
  "compilerOptions": {
    "target": "ES2022",
    "useUnknownInCatchVariables": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/components/*": ["src/components/*"],
      "@/lib/*": ["src/lib/*"],
      "@/sentry/*": ["src/sentry/*"],
      "@/app/*": ["app/*"],
    },
  },
  "include": ["next.config.ts", "tsconfig.json", "src", "app"],
  "exclude": ["node_modules", ".next"],
}