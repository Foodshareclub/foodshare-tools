{
  "name": "foodshare-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "type-check": "bun run next typegen && bun run tsrs --noEmit",
    "lint": "bunx --bun oxlint --ignore-pattern=.next/** --ignore-pattern=node_modules/**",
    "test": "bun test --pass-with-no-tests",
    "sentry:init": "sentry-cli init",
    "sentry:release": "sentry-cli releases",
    "sentry:debug": "sentry-cli keys deploy",
    "db:push": "supabase db push",
    "functions:deploy": "supabase functions deploy",
    "logs": "supabase functions logs"
  },
  "dependencies": {
    "next": "16.5.0-canary.19",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@sentry/nextjs": "10.71.0",
    "@sentry/react": "10.71.0",
    "@sentry/browser": "10.71.0",
    "@sentry/feedback": "10.71.0",
    "@sentry/replay": "10.71.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "date-fns": "4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "oxlint": "1.80.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "7.1.0-beta"
  }
}
