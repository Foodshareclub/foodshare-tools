# Rust build artifacts
/target/
**/*.rs.bk

# Cargo.lock is committed on purpose. The workspace ships binaries and
# generates WebAssembly modules that are committed to the web repository,
# so the versions those are built from have to be pinned. The published
# libraries keep their version ranges, so committing the lockfile does
# not constrain anyone who depends on them.

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# macOS
.DS_Store
# AppleDouble resource forks (macOS writes these beside every file it
# touches on non-HFS volumes; they are noise, never content).
._*
.AppleDouble
.LSOverride

# Test artifacts
*.profraw
*.profdata
coverage/

# Build outputs
*.so
*.dylib
*.dll
*.a

# Next.js build output (crates/web)
crates/web/.next/
crates/web/next-env.d.ts
*.tsbuildinfo

# Compiled CLI binaries (`bun build --compile`)
dist/

# Local configuration
.env
.env.local
*.local.toml
node_modules
